# Copy this file to .env and fill in your values.

# Summarization — you need ONE of three backends (see SETUP.md):
#   1. A Claude Pro/Max subscription (no key here at all — just `claude login`).
#   2. GEMINI_API_KEY below, whose free tier covers this app.
#   3. ANTHROPIC_API_KEY below, billed per token.
#
# NOTE: if ANTHROPIC_API_KEY is set, it takes priority over your Claude
# subscription for anything that could use either — the app hides it while
# calling the subscription backend, but leave it blank if you only ever want
# to use the subscription.
ANTHROPIC_API_KEY=

# Required — push summaries to Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional — enables auto-resolving Spotify links to a downloadable RSS audio
# file. Without these, pasting a Spotify link will prompt you for a direct
# audio/RSS link instead. Register a free app at
# https://developer.spotify.com/dashboard to get these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — enables cloud transcription via Groq (much faster than local
# Whisper). Free tier available, no card required. Get a key at
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional — enables Gemini for transcription (the only provider here that
# labels speakers) and/or summarization. Free tier, no card required. Get a
# key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — only needed when deploying publicly (e.g. Streamlit Community
# Cloud). If set, the app requires this password before showing anything.
# Leave blank for local use — no gate, no friction.
APP_PASSWORD=
